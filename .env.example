# Copy these placeholders into your local environment and source/export them
# before starting Maven or Vite; the applications do not auto-load this file.
# Backend runtime
PORT=8080
DB_URL=jdbc:mysql://127.0.0.1:3306/sat_project?useUnicode=true&characterEncoding=utf8&useSSL=false
DB_USERNAME=replace_me
DB_PASSWORD=replace_me
JWT_SECRET=replace_with_at_least_32_random_characters
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=replace_me
MAIL_PASSWORD=replace_me
MAIL_SSL_ENABLE=false

# Frontend runtime. VITE_ values are embedded in the browser bundle; they are
# configuration, not server-side secrets. Use a backend proxy for secret keys.
VITE_DICTIONARY_API_KEY=replace_me
